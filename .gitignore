# --- Secrets / API keys: never commit ----------------------------------------
.env
.env.*
!.env.example

# --- Copyrighted textbook material: do NOT publish ---------------------------
# Contains the full ISLP book PDF and per-chapter Springer PDFs.
Source_Material/

# --- Assessment material: do NOT publish -------------------------------------
# Mock exams, their solutions and their LaTeX sources stay off GitHub.
Mock_Exams/
# The runsheets say which exercises map onto which exam problems, so they are
# assessment material too. Delete these two lines if you want them public.
Teaching_Guide/runsheets/

# --- Build output -------------------------------------------------------------
Teaching_Guide/handouts/
# Marks the last successful make_figures.py run (see the Makefile).
.figures.stamp

# --- LaTeX build artifacts ----------------------------------------------------
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.fls
*.fdb_latexmk

# --- Jupyter / Python ----------------------------------------------------------
.ipynb_checkpoints/
__pycache__/
*.pyc
.venv/
venv/

# --- Data cache created by notebooks on Colab ----------------------------------
Chapters/*/data/

# --- Sphinx documentation -------------------------------------------------------
docs/_build/
# Staged by docs/conf.py on every build — never edit or commit these.
docs/labs/
docs/advanced_labs/
docs/_extra/

# Written by a project starter when a student runs it; not part of the repo.
Projects/*/shortlist.csv

# --- OS noise -------------------------------------------------------------------
.DS_Store
Thumbs.db
